// Tessera engine version. GENERATED by CMake from the VERSION file at the repo root:
// edit VERSION (Semantic Versioning, e.g. 1.2.0 or 2.0.0-beta.1), not this file.
#pragma once

#define TESSERA_VERSION_MAJOR @TESSERA_VERSION_MAJOR@
#define TESSERA_VERSION_MINOR @TESSERA_VERSION_MINOR@
#define TESSERA_VERSION_PATCH @TESSERA_VERSION_PATCH@
#define TESSERA_VERSION_PRERELEASE "@TESSERA_VERSION_PRERELEASE@"   // e.g. "beta.1", or ""
#define TESSERA_VERSION_STRING "@TESSERA_VERSION@"                  // the full version, e.g. "1.0.0"

#ifndef RC_INVOKED
#include <cstdint>

namespace Tessera {
struct Version {
    static constexpr uint32_t Major = TESSERA_VERSION_MAJOR;
    static constexpr uint32_t Minor = TESSERA_VERSION_MINOR;
    static constexpr uint32_t Patch = TESSERA_VERSION_PATCH;
    static constexpr const char* PreRelease = TESSERA_VERSION_PRERELEASE;
    static constexpr const char* String = TESSERA_VERSION_STRING;
};
} // namespace Tessera
#endif
